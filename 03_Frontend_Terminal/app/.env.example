NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id"
NEXT_PUBLIC_BUNDLER_URL="https://bundler.monad.xyz"
NEXT_PUBLIC_PAYMASTER_URL="https://paymaster.monad.xyz"

# ─── On-chain mode (F0-F2, TASK_BACKLOG2) ────────────────────────────
# Set to 1 AND fill every address below to enable chain execution.
# With the flag off or any address missing, the app runs in mock mode.
NEXT_PUBLIC_CHAIN_MODE=0
# Deploy 2026-10-13 — Monad Testnet (ver 04_Deploy_and_Networks/Contract_Addresses.md)
NEXT_PUBLIC_TIME_STREAM="0xE3209E6b0CC93BCBc05067956ACd1Cf1ec8118C8"
NEXT_PUBLIC_MILESTONE_ESCROW="0xA8f6Fc4a96AD87B4ac4f93cE6F05F9e208d6d817"
NEXT_PUBLIC_MOCK_USDC="0x27BE5512a477045EF270EE16c804776D6269663C"
NEXT_PUBLIC_MOCK_ARS="0x1569b7c9115DF4AFeE1C71689D8E390bceea4958"
NEXT_PUBLIC_MOCK_EXCHANGE="0x1C87797a412519BbB4AB62e29E24D2530E200026"
# Server-only: faucet that sends MON for gas until the paymaster lands.
# Never expose this key to the client (no NEXT_PUBLIC_ prefix).
GAS_FAUCET_PRIVATE_KEY=""
